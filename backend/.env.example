# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sso_idp"

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=

# JWT TTL (optional — defaults shown)
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email — SMTP (Yandex, Gmail app password, etc.)
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=you@yandex.ru
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=you@yandex.ru   # optional, defaults to SMTP_USER

# CORS — comma-separated list of allowed origins (omit in development)
# CORS_ORIGIN=https://yourdomain.com

# Redis — optional, enables shared rate-limit counters across instances
# REDIS_URL=redis://localhost:6379

# Server
PORT=3000
NODE_ENV=development
